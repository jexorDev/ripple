@page "/"

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Ripple.DataLayer.Classes
@using Ripple.DataLayer.Repos
@using Ripple.Utility
@rendermode InteractiveServer


@inject ProtectedLocalStorage ProtectedLocalStorage
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<PageTitle>Ripple Home</PageTitle>

<FluentGrid>
    <FluentGridItem sm="12">
        <div class="h2">Ripple</div>
    </FluentGridItem>

@foreach (var itinerary in itineraries)
{
    <FluentGridItem sm="3" xs="12">
        <FluentCard>
                <div class="h4">@itinerary.Name</div>
            @itinerary.ItineraryDate.Value.ToString("MM/dd/yyyy")
            <FluentButton @onclick="() => MoveToSelectedItinerary(itinerary.Id)" Appearance="Appearance.Accent">Edit</FluentButton>
        </FluentCard>

    </FluentGridItem>

}

    <FluentGridItem sm="3">
        <FluentCard>
            <FluentButton @onclick="() => AddItinerary()" Appearance="Appearance.Lightweight">Add New</FluentButton>
        </FluentCard>

    </FluentGridItem>

</FluentGrid>


@code {
    private List<Itinerary> itineraries = new List<Itinerary>();

    protected override void OnAfterRender(bool isFirstRender)
    {
        if (isFirstRender)
        {
            LoadItineraries();

        }
    }

    private void LoadItineraries()
    {
        using (var connection = new DatabaseConnectionProvider(Configuration))
        {
            itineraries = new ItineraryRepository().Get(null, connection.GetConnection());
        }

        StateHasChanged();        
    }

    private void AddItinerary()
    {
        NavigationManager.NavigateTo($"/itinerary");
    }

    private void MoveToSelectedItinerary(int id)
    {
        NavigationManager.NavigateTo($"/itinerary/{id}");
        
    }

}
