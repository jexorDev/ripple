@page "/itinerary/{id:int?}"
@using System.Linq
@using Ripple.DataLayer.Classes
@using Ripple.DataLayer.Repos
@using Google.Api.Gax.Grpc
@using Google.Maps.Places.V1
@using Google.Maps.Routing.V2
@using Google.Type
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Ripple.Utility
@rendermode InteractiveServer

@inject IConfiguration Configuration
@inject ProtectedLocalStorage ProtectedLocalStorage
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Ripple Itinerary Planner</PageTitle>



<FluentGrid>
    <FluentGridItem sm="5">

        <FluentButton Appearance="Appearance.Lightweight" class="h2" Style="margin-top:5px" @onclick=GoHome>Ripple</FluentButton>
    </FluentGridItem>
    <FluentGridItem sm="7" xs="12">
        <FluentAutocomplete TOption="Place"
                            Label="Search places"
                            Position="SelectPosition.Below"
                            OnOptionsSearch="@OnSearchPlacesAsync"
                            ImmediateDelay="500"
                            Style="max-width:500px"
                            Multiple=false
                            @bind-SelectedOption="selectedPlace">
            <OptionTemplate>
                <FluentStack>
                    @context.DisplayName.Text
                    @context.FormattedAddress
                </FluentStack>
            </OptionTemplate>
        </FluentAutocomplete>

    </FluentGridItem>




    <FluentGridItem sm="2" xs="12">
        <FluentCard>
            <div class="h3">Your Itinerary</div>
            <FluentTextField @bind-Value="itinerary.Name" Label="Name"></FluentTextField>
            <FluentDatePicker @bind-Value="itinerary.ItineraryDate" Label="Start Date"></FluentDatePicker>
            <FluentTimePicker @bind-Value="itinerary.ItineraryTime" Label="Start Time"></FluentTimePicker>
            @* <FluentCheckbox @bind-Value=usePublicTransit Label="Use Public Transit" /> *@
            <FluentButton @onclick=UpdateSecondsAwayOnPlaces Appearance="Appearance.Outline" Style="margin-top:5px;width:100%">Recalc. arrival/departure</FluentButton>
            <FluentButton @onclick="Save" Appearance="Appearance.Accent" Style="margin-top:2px;width:100%">Save</FluentButton>
        </FluentCard>

    </FluentGridItem>
    <FluentGridItem sm="10" xs="12">
        @if (itinerary.AddedPlaces.Count == 0)
        {
            <div class="h2" style="font-style:italic; color:grey; text-align:center">Places will appear here once you add them from the search bar above</div>
            <div class="h4" style="font-style:italic; color:grey; text-align:center">Make sure to use the blue save button often to save changes</div>
        }
        
        <FluentDragContainer TItem="ItineraryPlace" OnDropEnd="PlaceDragDropEnd">
            <FluentGrid Spacing="1">
                @foreach (var addedPlace in itinerary.AddedPlaces.OrderBy(x => x.Index))
                {
                    <FluentGridItem sm="12">
                        @if (addedPlace.Index == 1)
                        {
                            <FluentCard>
                                <FluentGrid>
                                    <FluentGridItem sm="3">
                                        <FluentDropZone Id="@addedPlace.Index.ToString()" Item="@addedPlace" Draggable="true" Droppable="true">
                                            <FluentBadge Appearance="Appearance.Accent">@addedPlace.Index</FluentBadge>
                                            @addedPlace.Place.DisplayName.Text
                                            @addedPlace.Place.FormattedAddress

                                        </FluentDropZone>
                                    </FluentGridItem>
                                    <FluentGridItem sm="2">
                                        <FluentBadge Fill="blah" BackgroundColor="mediumseagreen" Color="white">Start</FluentBadge>
                                    </FluentGridItem>
                                    <FluentGridItem sm="2">
                                        <FluentLabel>Departure Time</FluentLabel>
                                        <FluentLabel Typo="Typography.H6">@addedPlace.DepartureTime.ToShortTimeString()</FluentLabel>

                                    </FluentGridItem>
                                    <FluentGridItem xs="6" sm="2">
                                    </FluentGridItem>
                                    <FluentGridItem xs="6" sm="2">

                                    </FluentGridItem>

                                    <FluentGridItem xs="6" sm="1">
                                        <FluentStack Orientation="Orientation.Vertical">
                                            <FluentButton @onclick="() => Delete(addedPlace)" Appearance="Appearance.Lightweight">Delete</FluentButton>

                                        </FluentStack>

                                    </FluentGridItem>
                                </FluentGrid>

                            </FluentCard>
                        }
                        else
                        {
                            <FluentCard>
                                <FluentGrid>
                                    <FluentGridItem sm="3">
                                        <FluentDropZone Id="@addedPlace.Index.ToString()" Item="@addedPlace" Draggable="true" Droppable="true">
                                            <FluentBadge Appearance="Appearance.Accent">@addedPlace.Index</FluentBadge>
                                            @addedPlace.Place.DisplayName.Text
                                            @addedPlace.Place.FormattedAddress

                                        </FluentDropZone>
                                    </FluentGridItem>
                                    <FluentGridItem sm="2">
                                        <FluentLabel>Arrival Time</FluentLabel>
                                        <FluentLabel Typo="Typography.H6"> @addedPlace.ArrivalTime.ToShortTimeString() </FluentLabel>
                                    </FluentGridItem>
                                    <FluentGridItem sm="2">
                                        @if (addedPlace.Index == itinerary.AddedPlaces.Count())
                                        {
                                            <FluentBadge Fill="blah" BackgroundColor="crimson" Color="white">End</FluentBadge>
                                        }
                                        else
                                        {
                                            <FluentLabel>Departure Time</FluentLabel>
                                            <FluentLabel Typo="Typography.H6">@addedPlace.DepartureTime.ToShortTimeString()</FluentLabel>
                                        }

                                    </FluentGridItem>
                                    <FluentGridItem xs="6" sm="2">
                                        <FluentNumberField @bind-Value="addedPlace.VisitHours" Label="Visit Time (hrs)"></FluentNumberField>
                                    </FluentGridItem>
                                    <FluentGridItem xs="6" sm="2">
                                        <FluentNumberField @bind-Value="addedPlace.MinutesAwayFromPreviousPlace" Label="Commute Time (min)"></FluentNumberField>

                                    </FluentGridItem>

                                    <FluentGridItem xs="6" sm="1">
                                        <FluentStack Orientation="Orientation.Vertical">
                                            <FluentAnchor Href="@addedPlace.GoogleMapsUrl" Target="_blank" Appearance="Appearance.Lightweight">Directions</FluentAnchor>
                                            <FluentButton @onclick="() => Delete(addedPlace)" Appearance="Appearance.Lightweight">Delete</FluentButton>

                                        </FluentStack>

                                    </FluentGridItem>
                                </FluentGrid>

                            </FluentCard>

                        }

                    </FluentGridItem>
                }
            </FluentGrid>
        </FluentDragContainer>
    </FluentGridItem>
</FluentGrid>









@code {
    [Parameter]
    public int? Id { get; set; }

    private Itinerary _backingItinerary = new Itinerary();
    private Itinerary itinerary
    {
        get => _backingItinerary;
        set
        {
            _backingItinerary = value;
            StateHasChanged();
        }
    }

    private void GoHome() => NavigationManager.NavigateTo("/");

    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            if (Id.HasValue)
            {
                using (var connection = new DatabaseConnectionProvider(Configuration))
                {
                    itinerary = new ItineraryRepository().Get(Id.Value, connection.GetConnection()).FirstOrDefault();
                    itinerary.AddedPlaces = new ItineraryPlacesRepository().Get(Id.Value, connection.GetConnection());
                }
            }
            else
            {
                itinerary.Name = "My Itinerary";
                itinerary.ItineraryDate = System.DateTime.Now;
                itinerary.ItineraryTime = System.DateTime.Now;
            }

            StateHasChanged();

        }
    }

    private void Save()
    {
        using (var connection = new DatabaseConnectionProvider(Configuration))
        {
            var placeRepo = new PlaceRepository();
            var itineraryPlaceRepo = new ItineraryPlacesRepository();
            var itineraryRepo = new ItineraryRepository();

            connection.SetTransaction();

            if (!Id.HasValue)
            {
                Id = itineraryRepo.Create(itinerary, connection.GetConnection());
            }
            else
            {
                itineraryRepo.Update(itinerary, connection.GetConnection());
                itineraryPlaceRepo.DeleteAllPlaces(Id.Value, connection.GetConnection());
            }

            foreach (var place in itinerary.AddedPlaces)
            {
                placeRepo.Save(place.Place, connection.GetConnection());
                itineraryPlaceRepo.Save(place, Id.Value, connection.GetConnection());
            }

            connection.CompleteTransaction();

            ToastService.ShowToast(ToastIntent.Success, "Itinerary successfully saved");
        }
    }


    private void PlaceDragDropEnd(FluentDragEventArgs<ItineraryPlace> args)
    {
        var sourceIndex = args.Source.Item.Index;
        var targetIndex = args.Target.Item.Index;

        ShiftPlaces(sourceIndex, targetIndex);
        args.Source.Item.Index = targetIndex;

        StateHasChanged();
    }

    private void ShiftPlaces(int sourceIndex, int targetIndex)
    {

        if (sourceIndex < targetIndex)
        {
            for (int i = sourceIndex + 1; i <= targetIndex; i++)
            {
                var currentPlace = itinerary.AddedPlaces.FirstOrDefault(x => x.Index == i);
                if (currentPlace != null)
                {
                    currentPlace.Index -= 1;
                }
            }
        }
        else
        {
            for (int i = sourceIndex - 1; i >= targetIndex; i--)
            {
                var currentPlace = itinerary.AddedPlaces.FirstOrDefault(x => x.Index == i);
                if (currentPlace != null)
                {
                    currentPlace.Index += 1;
                }
            }
        }
    }

    private Place? _backingPlace;
    private Place? selectedPlace
    {
        get => null;
        set
        {
            _backingPlace = value;
            if (value != null)
            {
                AddPlace(value);
            }
        }
    }

    private async Task OnSearchPlacesAsync(OptionsSearchEventArgs<Place> e)
    {
        if (string.IsNullOrWhiteSpace(e.Text))
        {
            e.Items = [];
        }
        else
        {

            PlacesClient client = new PlacesClientBuilder
                {
                    ApiKey = Configuration["GoogleAPIKey"]
                }.Build();
            CallSettings callSettings = CallSettings.FromHeader("X-Goog-FieldMask", "*");
            SearchTextRequest request = new SearchTextRequest
                {
                    TextQuery = e.Text
                };
            SearchTextResponse response = client.SearchText(request, callSettings);
            e.Items = response.Places.ToList();

        }
    }


    private bool usePublicTransit = false;



    private void AddPlace(Place place)
    {
        int nextIndex = itinerary.AddedPlaces.Count + 1;
        itinerary.AddedPlaces.Add(new ItineraryPlace
            {
                Index = nextIndex,
                Place = place
            });

        UpdateSecondsAwayOnPlaces();
    }

    private void Delete(ItineraryPlace place)
    {
        itinerary.AddedPlaces.Remove(place);
        foreach (var addedPlace in itinerary.AddedPlaces.Where(x => x.Index > place.Index))
        {
            addedPlace.Index--;
        }
        UpdateSecondsAwayOnPlaces();

    }

    private void UpdateItineraryTimes()
    {
        foreach (var place in itinerary.AddedPlaces.OrderBy(x => x.Index))
        {
            var currentPlace = place;
            var previousPlace = itinerary.AddedPlaces.FirstOrDefault(x => x.Index == currentPlace.Index - 1);

            if (previousPlace == null && itinerary.ItineraryDate.HasValue && itinerary.ItineraryTime.HasValue)
            {
                currentPlace.DepartureTime = new System.DateTime(itinerary.ItineraryDate.Value.Year, itinerary.ItineraryDate.Value.Month, itinerary.ItineraryDate.Value.Day, itinerary.ItineraryTime.Value.Hour, itinerary.ItineraryTime.Value.Minute, 00);
            }
            else
            {
                currentPlace.ArrivalTime = previousPlace.DepartureTime.AddMinutes(currentPlace.MinutesAwayFromPreviousPlace);
                currentPlace.DepartureTime = currentPlace.ArrivalTime.AddHours(currentPlace.VisitHours);
            }
        }

        ToastService.ShowToast(ToastIntent.Info, "Departure and arrival times on places are now up to date");

    }

    private void UpdateSecondsAwayOnPlaces()
    {
        RoutesClient googleRoutesClient = new RoutesClientBuilder
            {
                ApiKey = Configuration["GoogleAPIKey"]
            }.Build();

        foreach (var place in itinerary.AddedPlaces.OrderBy(x => x.Index))
        {
            var currentPlace = place;
            var previousPlace = itinerary.AddedPlaces.FirstOrDefault(x => x.Index == currentPlace.Index - 1);

            if (previousPlace == null)
            {
                //currentPlace.SecondsAwayFromPreviousPlace = 0;
                continue;
            }

            const string GoogleMapsUrl = "https://www.google.com/maps/dir/?api=1&origin={0},{1}&origin_place_id={2}&destination={3},{4}&destination_place_id={4}&travelmode={5}";

            currentPlace.GoogleMapsUrl = string.Format(
                GoogleMapsUrl,
                previousPlace.Place.Location.Latitude,
                previousPlace.Place.Location.Longitude,
                previousPlace.Place.Id,
                currentPlace.Place.Location.Latitude,
                currentPlace.Place.Location.Longitude,
                currentPlace.Place.Id,
                (usePublicTransit ? "transit" : "drive"));


            if (!currentPlace.Place.PostalAddress.RegionCode.Equals("JP"))
            {
                SetCommuteTimeFromGoogle(currentPlace, previousPlace, googleRoutesClient);
            }

        }
        UpdateItineraryTimes();
    }

    private void SetCommuteTimeFromGoogle(ItineraryPlace currentPlace, ItineraryPlace previousPlace, RoutesClient client)
    {

        CallSettings callSettings = CallSettings.FromHeader("X-Goog-FieldMask", "routes.*");
        ComputeRoutesRequest request = new ComputeRoutesRequest
            {
                Origin = new Waypoint
                {
                //Location = new Location { LatLng = new LatLng { Latitude = 37.419734, Longitude = -122.0827784 } }
                //Address = "Humberto Delgado Airport, Portugal"
                //Address = previousPlace.Place.FormattedAddress
                    Location = new Location { LatLng = new LatLng { Latitude = previousPlace.Place.Location.Latitude, Longitude = previousPlace.Place.Location.Longitude } },
                //Address = previousPlace.Place.PlusCode.CompoundCode,
                //PlaceId = previousPlace.Place.Id
                },
                Destination = new Waypoint
                {
                //Location = new Location { LatLng = new LatLng { Latitude = 37.417670, Longitude = -122.079595 } }
                //Address = "Basílica of Estrela, Praça da Estrela, 1200-667 Lisboa, Portugal"
                //Address = currentPlace.Place.FormattedAddress
                    Location = new Location { LatLng = new LatLng { Latitude = currentPlace.Place.Location.Latitude, Longitude = currentPlace.Place.Location.Longitude } },
                //Address = currentPlace.Place.PlusCode.CompoundCode,
                //PlaceId = currentPlace.Place.Id
                },
                TravelMode = usePublicTransit ? RouteTravelMode.Transit : RouteTravelMode.Drive,
            //ComputeAlternativeRoutes = true
            };
        ComputeRoutesResponse response = client.ComputeRoutes(request, callSettings);
        //currentPlace.SecondsAwayFromPreviousPlace = response.Routes.FirstOrDefault()?.Duration.Seconds ?? 0;
        currentPlace.MinutesAwayFromPreviousPlace = (response.Routes.FirstOrDefault()?.Duration.Seconds ?? 0) / 60;

    }

}
