@page "/itinerary/{id:int?}"
@using System.Linq
@using Ripple.DataLayer.Classes
@using Ripple.DataLayer.Models
@using Ripple.DataLayer.Repos
@using Google.Api.Gax.Grpc
@using Google.Maps.Places.V1
@using Google.Maps.Routing.V2
@using Google.Type
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Ripple.Utility
@using System.ComponentModel
@using System.Web
@rendermode InteractiveServer

@inject IConfiguration Configuration
@inject ProtectedLocalStorage ProtectedLocalStorage
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Ripple Itinerary Planner</PageTitle>

<FluentGrid Justify="JustifyContent.FlexEnd">
    <FluentGridItem sm="4" xs="12">
        <FluentBreadcrumb>
            <FluentBreadcrumbItem @onclick="() => GoHome()">Itineraries</FluentBreadcrumbItem> 
            <FluentLabel Href="#" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Accent" @onclick="() => IsItineraryEditPopoverOpen = true" Style="cursor:pointer">@Itinerary.Name</FluentLabel>
        </FluentBreadcrumb>

        <FluentStack Orientation="Orientation.Horizontal" Id="ItineraryHeaderInfo">
            <FluentLabel Typo="Typography.Body" Color="@Microsoft.FluentUI.AspNetCore.Components.Color.Accent" Weight="FontWeight.Bold" @onclick="() => IsItineraryEditPopoverOpen = true" Style="cursor:pointer">
                @ItineraryDateTime
            </FluentLabel>

        </FluentStack>
        <FluentPopover AnchorId="ItineraryHeaderInfo" @bind-Open="IsItineraryEditPopoverOpen">
            <Header>Your Itinerary</Header>
            <Body>
                <FluentTextField @bind-Value="Itinerary.Name" Label="Name"></FluentTextField>
                <FluentDatePicker @bind-Value="Itinerary.ItineraryDate" Label="Start Date"></FluentDatePicker>
                <FluentTimePicker @bind-Value="Itinerary.ItineraryTime" Label="Start Time"></FluentTimePicker>
                <FluentButton Appearance="Appearance.Accent" @onclick="() => IsItineraryEditPopoverOpen = false">Done</FluentButton>
            </Body>
        </FluentPopover>
    </FluentGridItem>
    <FluentGridItem sm="4" xs="12">
        <FluentAutocomplete TOption="Place"
        Label="Search places"
        Position="SelectPosition.Below"
        OnOptionsSearch="@OnSearchPlacesAsync"
        ImmediateDelay="500"
        Style="max-width:500px"
        Multiple=false
        @bind-SelectedOption="selectedPlace">
            <OptionTemplate>
                <FluentStack>
                    @context.DisplayName.Text
                    @context.FormattedAddress
                </FluentStack>
            </OptionTemplate>
        </FluentAutocomplete>

    </FluentGridItem>
    <FluentGridItem sm="4" xs="12" Justify="JustifyContent.Center">
        <FluentButton Appearance="Appearance.Accent" @onclick=Save Style="margin-top:10px">Save changes</FluentButton>

    </FluentGridItem>


    <FluentGridItem sm="6">
        @if (ItineraryPlaces.Count == 0)
        {
            <div class="h2" style="font-style:italic; color:grey; text-align:center">Places will appear here once you add them from the search bar above</div>
            <div class="h4" style="font-style:italic; color:grey; text-align:center">Make sure to use the blue save button often to save changes</div>
        }

        <FluentDragContainer TItem="ItineraryPlaceModel" OnDropEnd="PlaceDragDropEnd">
            <FluentGrid Spacing="1">
                @foreach (var addedPlace in ItineraryPlaces.OrderBy(x => x.Index))
                {

                    @if (addedPlace.Index != 1)
                    {
                        <FluentGridItem sm="12">
                            <FluentStack Orientation="Orientation.Horizontal">
                                <FluentNumberField @bind-Value="addedPlace.CommuteMinutes" Label="Commute Time (min)" Style="width:90px"></FluentNumberField>
                                <FluentAnchor Href="@addedPlace.GoogleMapsDirectionsUrl" Target="_blank" Appearance="Appearance.Lightweight">Directions</FluentAnchor>
                            </FluentStack>
                        </FluentGridItem>
                    }
                    <FluentGridItem sm="12">
                        <FluentCard>
                            <FluentGrid>
                                <FluentGridItem sm="4" xs="12">
                                    <FluentDropZone Id="@addedPlace.Index.ToString()" Item="@addedPlace" Draggable="true" Droppable="true">
                                        <FluentBadge Appearance="Appearance.Accent">@addedPlace.Index</FluentBadge>
                                            @addedPlace.Place.DisplayName.Text
                                            @addedPlace.Place.FormattedAddress
                                    </FluentDropZone>
                                </FluentGridItem>
                                <FluentGridItem sm="2" xs="4">
                                    @if (addedPlace.Index == 1)
                                    {
                                        <FluentBadge Fill="blah" BackgroundColor="mediumseagreen" Color="white">Start</FluentBadge>
                                    }
                                    else
                                    {
                                        <FluentLabel>Arrival Time</FluentLabel>
                                        <FluentLabel Typo="Typography.H6"> @addedPlace.ArrivalTime.ToShortTimeString() </FluentLabel>

                                    }
                                </FluentGridItem>
                                <FluentGridItem sm="2" xs="4">
                                    @if (addedPlace.Index == ItineraryPlaces.Count() && ItineraryPlaces.Count() > 1)
                                    {
                                        <FluentBadge Fill="blah" BackgroundColor="crimson" Color="white">End</FluentBadge>
                                    }
                                    else
                                    {
                                        <FluentLabel>Departure Time</FluentLabel>
                                        <FluentLabel Typo="Typography.H6">@addedPlace.DepartureTime.ToShortTimeString()</FluentLabel>
                                    }

                                </FluentGridItem>
                                <FluentGridItem sm="2" xs="4">
                                    @if (addedPlace.Index != 1 && addedPlace.Index != ItineraryPlaces.Count())
                                    {
                                        <FluentNumberField @bind-Value="addedPlace.VisitHours" Label="Visit Time (hrs)" style="width:90px"></FluentNumberField>

                                    }
                                </FluentGridItem>


                                <FluentGridItem sm="1" xs="6">
                                        <FluentButton @onclick="() => Delete(addedPlace)" Appearance="Appearance.Lightweight">Delete</FluentButton>
                                        <FluentAnchor Href="@addedPlace.GoogleMapsPlaceUrl" Target="_blank" Appearance="Appearance.Lightweight"><FluentIcon Value="@(new Icons.Regular.Size16.Open())"/>View</FluentAnchor>
                                    

                                </FluentGridItem>
                            </FluentGrid>

                        </FluentCard>

                    </FluentGridItem>


                }
            </FluentGrid>
        </FluentDragContainer>
    </FluentGridItem>
    <FluentGridItem sm="6">
        @if (MapByteArray != null)
        {
            <img src="data:image;base64, @System.Convert.ToBase64String(MapByteArray)"  />

        }
    </FluentGridItem>
</FluentGrid>


@code {
    [Parameter]
    public int? Id { get; set; }

    private ItineraryModel Itinerary = new ItineraryModel();
    private List<ItineraryPlaceModel> ItineraryPlaces { get; set; } = new List<ItineraryPlaceModel>();

    private byte[]? MapByteArray;
    private bool IsItineraryEditPopoverOpen { get; set; }

    private void GoHome() => NavigationManager.NavigateTo(NavigationManager.BaseUri);

    private string ItineraryDateTime => Itinerary.ItineraryDate.HasValue && Itinerary.ItineraryTime.HasValue ?
                                            Itinerary.ItineraryDate.Value.ToString("MM/dd/yyyy") + " " + Itinerary.ItineraryTime.Value.ToShortTimeString() :
                                            string.Empty;

    protected override void OnAfterRender(bool isFirstRender)
    {
        if (isFirstRender)
        {
            if (Id.HasValue)
            {
                using (var connection = new DatabaseConnectionProvider(Configuration))
                {
                    var existingItinerary = new ItineraryRepository().Get(Id.Value, connection.GetConnection()).FirstOrDefault();
                    if (existingItinerary != null)
                    {
                        Itinerary = new ItineraryModel(existingItinerary);
                        Itinerary.PropertyChanged += ItineraryPlaceHoursChanged;
                    }

                    var existingItineraryPlaces = new ItineraryPlacesRepository().Get(Id.Value, connection.GetConnection());

                    foreach (var addedPlace in existingItineraryPlaces)
                    {
                        var model = new ItineraryPlaceModel(addedPlace);
                        //TODO: Look into collection for handling changes
                        model.PropertyChanged += ItineraryPlaceHoursChanged;
                        ItineraryPlaces.Add(model);
                    }
                }

                SetGoogleMapsDirectionsUrl();
                UpdateItineraryTimes();
                RefreshMap();
            }
            else
            {
                Itinerary.Name = "My New Itinerary";
                Itinerary.ItineraryDate = System.DateTime.Now;
                Itinerary.ItineraryTime = System.DateTime.Now;
            }

            StateHasChanged();

        }
    }

    private void ItineraryPlaceHoursChanged(object? obj, PropertyChangedEventArgs e)
    {
        UpdateItineraryTimes();
    }

    private void Save()
    {
        using (var connection = new DatabaseConnectionProvider(Configuration))
        {
            var placeRepo = new PlaceRepository();
            var itineraryPlaceRepo = new ItineraryPlacesRepository();
            var itineraryRepo = new ItineraryRepository();

            connection.SetTransaction();

            Itinerary.Save(itineraryRepo, connection.GetConnection());


            itineraryPlaceRepo.DeleteAllPlaces(Itinerary.Id.Value, connection.GetConnection());

            foreach (var place in ItineraryPlaces)
            {
                placeRepo.Save(place.Place, connection.GetConnection());
                place.Save(Itinerary.Id.Value, itineraryPlaceRepo, connection.GetConnection());
            }

            connection.CompleteTransaction();

            ToastService.ShowToast(ToastIntent.Success, "Itinerary successfully saved");
        }
    }


    private void PlaceDragDropEnd(FluentDragEventArgs<ItineraryPlaceModel> args)
    {
        var sourceIndex = args.Source.Item.Index;
        var targetIndex = args.Target.Item.Index;

        ShiftPlaces(sourceIndex, targetIndex);
        args.Source.Item.Index = targetIndex;

        RefreshMap();
        SetCommuteTime();

        StateHasChanged();
    }

    private void ShiftPlaces(int sourceIndex, int targetIndex)
    {

        if (sourceIndex < targetIndex)
        {
            for (int i = sourceIndex + 1; i <= targetIndex; i++)
            {
                var currentPlace = ItineraryPlaces.FirstOrDefault(x => x.Index == i);
                if (currentPlace != null)
                {
                    currentPlace.Index -= 1;
                }
            }
        }
        else
        {
            for (int i = sourceIndex - 1; i >= targetIndex; i--)
            {
                var currentPlace = ItineraryPlaces.FirstOrDefault(x => x.Index == i);
                if (currentPlace != null)
                {
                    currentPlace.Index += 1;
                }
            }
        }
    }

    private Place? _backingPlace;
    private Place? selectedPlace
    {
        get => null;
        set
        {
            _backingPlace = value;
            if (value != null)
            {
                AddPlace(value);
            }
        }
    }

    private async Task OnSearchPlacesAsync(OptionsSearchEventArgs<Place> e)
    {
        if (string.IsNullOrWhiteSpace(e.Text))
        {
            e.Items = [];
        }
        else
        {

            PlacesClient client = new PlacesClientBuilder
                {
                    ApiKey = Configuration["GoogleAPIKey"]
                }.Build();
            CallSettings callSettings = CallSettings.FromHeader("X-Goog-FieldMask", "*");
            SearchTextRequest request = new SearchTextRequest
                {
                    TextQuery = e.Text
                };
            SearchTextResponse response = client.SearchText(request, callSettings);
            e.Items = response.Places.ToList();

        }
    }


    private bool usePublicTransit = false;



    private void AddPlace(Place place)
    {
        int nextIndex = ItineraryPlaces.Count + 1;
        var model = new ItineraryPlaceModel(new ItineraryPlace
            {
                Index = nextIndex,
                Place = place
            });
        model.PropertyChanged += ItineraryPlaceHoursChanged;
        ItineraryPlaces.Add(model);

        RefreshMap();
        SetCommuteTime();
    }

    private void Delete(ItineraryPlaceModel place)
    {
        ItineraryPlaces.Remove(place);
        foreach (var addedPlace in ItineraryPlaces.Where(x => x.Index > place.Index))
        {
            addedPlace.Index--;
        }
        RefreshMap();
        SetCommuteTime();

    }

    private void UpdateItineraryTimes()
    {
        if (!Itinerary.ItineraryTime.HasValue || !Itinerary.ItineraryDate.HasValue) return;

        foreach (var place in ItineraryPlaces.OrderBy(x => x.Index))
        {
            var currentPlace = place;
            var previousPlace = ItineraryPlaces.FirstOrDefault(x => x.Index == currentPlace.Index - 1);

            if (previousPlace == null && Itinerary.ItineraryDate.HasValue && Itinerary.ItineraryTime.HasValue)
            {
                currentPlace.DepartureTime = new System.DateTime(Itinerary.ItineraryDate.Value.Year, Itinerary.ItineraryDate.Value.Month, Itinerary.ItineraryDate.Value.Day, Itinerary.ItineraryTime.Value.Hour, Itinerary.ItineraryTime.Value.Minute, 00);
            }
            else
            {
                currentPlace.ArrivalTime = previousPlace.DepartureTime.AddMinutes(currentPlace.CommuteMinutes);
                currentPlace.DepartureTime = currentPlace.ArrivalTime.AddHours(currentPlace.VisitHours);
            }
        }
    }

    private void SetGoogleMapsDirectionsUrl()
    {
        foreach (var place in ItineraryPlaces.OrderBy(x => x.Index))
        {
            var currentPlace = place;

            const string GoogleMapsPlaceUrl = "https://www.google.com/maps/search/?api=1&query={0}%2C{1}&query_place_id={2}";

            currentPlace.GoogleMapsPlaceUrl = string.Format(
                    GoogleMapsPlaceUrl,
                    currentPlace.Place.Location.Latitude,
                    currentPlace.Place.Location.Longitude,
                    currentPlace.Place.Id);

            var previousPlace = ItineraryPlaces.FirstOrDefault(x => x.Index == currentPlace.Index - 1);

            if (previousPlace == null)
            {
                continue;
            }

            const string GoogleMapsDirectionsUrl = "https://www.google.com/maps/dir/?api=1&origin={0},{1}&origin_place_id={2}&destination={3},{4}&destination_place_id={4}&travelmodDirectionse={5}";

            currentPlace.GoogleMapsDirectionsUrl = string.Format(
                GoogleMapsDirectionsUrl,
                previousPlace.Place.Location.Latitude,
                previousPlace.Place.Location.Longitude,
                previousPlace.Place.Id,
                currentPlace.Place.Location.Latitude,
                currentPlace.Place.Location.Longitude,
                currentPlace.Place.Id,
                (usePublicTransit ? "TRANSIT" : "DRIVE"));                         

        }
    }

    private async Task RefreshMap()
    {
        
        MapByteArray = await GoogleMaps.GetMapByteArray(Configuration["GoogleAPIKey"], Configuration["GoogleSecret"], ItineraryPlaces);
        StateHasChanged();
    }

    private void SetCommuteTime()
    {
        RoutesClient googleRoutesClient = new RoutesClientBuilder
            {
                ApiKey = Configuration["GoogleAPIKey"]
            }.Build();

        foreach (var place in ItineraryPlaces.OrderBy(x => x.Index))
        {
            var currentPlace = place;
            var previousPlace = ItineraryPlaces.FirstOrDefault(x => x.Index == currentPlace.Index - 1);

            if (previousPlace == null)
            {
                //currentPlace.SecondsAwayFromPreviousPlace = 0;
                continue;
            }         


            if (!currentPlace.Place.PostalAddress.RegionCode.Equals("JP"))
            {
                SetCommuteTimeFromGoogle(currentPlace, previousPlace, googleRoutesClient);
            }

        }
        SetGoogleMapsDirectionsUrl();
        UpdateItineraryTimes();
    }

    private void SetCommuteTimeFromGoogle(ItineraryPlaceModel currentPlace, ItineraryPlaceModel previousPlace, RoutesClient client)
    {

        CallSettings callSettings = CallSettings.FromHeader("X-Goog-FieldMask", "routes.*");
        ComputeRoutesRequest request = new ComputeRoutesRequest
            {
                Origin = new Waypoint
                {
                //Location = new Location { LatLng = new LatLng { Latitude = 37.419734, Longitude = -122.0827784 } }
                //Address = "Humberto Delgado Airport, Portugal"
                //Address = previousPlace.Place.FormattedAddress
                    Location = new Location { LatLng = new LatLng { Latitude = previousPlace.Place.Location.Latitude, Longitude = previousPlace.Place.Location.Longitude } },
                //Address = previousPlace.Place.PlusCode.CompoundCode,
                //PlaceId = previousPlace.Place.Id
                },
                Destination = new Waypoint
                {
                //Location = new Location { LatLng = new LatLng { Latitude = 37.417670, Longitude = -122.079595 } }
                //Address = "Basílica of Estrela, Praça da Estrela, 1200-667 Lisboa, Portugal"
                //Address = currentPlace.Place.FormattedAddress
                    Location = new Location { LatLng = new LatLng { Latitude = currentPlace.Place.Location.Latitude, Longitude = currentPlace.Place.Location.Longitude } },
                //Address = currentPlace.Place.PlusCode.CompoundCode,
                //PlaceId = currentPlace.Place.Id
                },
                TravelMode = usePublicTransit ? RouteTravelMode.Transit : RouteTravelMode.Drive,
            //ComputeAlternativeRoutes = true
            };
        ComputeRoutesResponse response = client.ComputeRoutes(request, callSettings);
        //currentPlace.SecondsAwayFromPreviousPlace = response.Routes.FirstOrDefault()?.Duration.Seconds ?? 0;
        currentPlace.CommuteMinutes = (response.Routes.FirstOrDefault()?.Duration.Seconds ?? 0) / 60;

    }

}
